<file path="Dockerfile">
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["RiftRoulette.csproj", "."]
RUN dotnet restore "./RiftRoulette.csproj"
COPY . .
